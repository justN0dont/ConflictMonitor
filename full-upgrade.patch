+      transparent,
+      transparent 59px,
+      rgba(88, 166, 255, 0.03) 59px,
+      rgba(88, 166, 255, 0.03) 60px
+    ),
+    repeating-linear-gradient(
+      90deg,
+      transparent,
+      transparent 59px,
+      rgba(88, 166, 255, 0.03) 59px,
+      rgba(88, 166, 255, 0.03) 60px
+    );
+}
+
+#root {
+  height: 100vh;
+  position: relative;
+  z-index: 1;
+}
+
+.app-grid {
+  display: grid;
+  grid-template-columns: 1fr 400px;
+  grid-template-rows: 52px 1fr 72px;
+  grid-template-areas:
+    "header  header"
+    "map     sidebar"
+    "timeline timeline";
+  height: 100vh;
+  gap: 1px;
+  background: var(--border);
+}
+
+.sidebar {
+  grid-area: sidebar;
+  display: flex;
+  flex-direction: column;
+  gap: 1px;
+  background: var(--border);
+}
+
+.sidebar-feed {
+  flex: 1;
+  overflow: hidden;
+  background: var(--bg-secondary);
+  box-shadow: 0 0 1px var(--border-glow), inset 0 0 1px rgba(88, 166, 255, 0.05);
+}
+
+.sidebar-gauge {
+  height: 200px;
+  flex-shrink: 0;
+  background: var(--bg-secondary);
+  box-shadow: 0 0 1px var(--border-glow), inset 0 0 1px rgba(88, 166, 255, 0.05);
+}
+
+.panel {
+  background: var(--bg-secondary);
+  overflow: hidden;
+  box-shadow: 0 0 1px var(--border-glow), inset 0 0 1px rgba(88, 166, 255, 0.05);
+}
+
+/* Scrollbar */
+::-webkit-scrollbar {
+  width: 4px;
+}
+::-webkit-scrollbar-track {
+  background: var(--bg-secondary);
+}
+::-webkit-scrollbar-thumb {
+  background: var(--border);
+  border-radius: 2px;
+}
+::-webkit-scrollbar-thumb:hover {
+  background: rgba(88, 166, 255, 0.3);
+}
+
+/* Radar ping animation for map markers */
+@keyframes radarPing {
+  0% {
+    transform: scale(1);
+    opacity: 0.8;
+  }
+  100% {
+    transform: scale(4);
+    opacity: 0;
+  }
+}
+
+@keyframes radarPingRed {
+  0% {
+    transform: scale(1);
+    opacity: 0.9;
+  }
+  50% {
+    opacity: 0.5;
+  }
+  100% {
+    transform: scale(5);
+    opacity: 0;
+  }
+}
+
+/* Scan-line animation for live feed */
+@keyframes scanLine {
+  0% {
+    transform: translateY(-100%);
+  }
+  100% {
+    transform: translateY(100%);
+  }
+}
+
+/* Smooth event slide-in */
+@keyframes slideIn {
+  0% {
+    opacity: 0;
+    transform: translateX(12px);
+  }
+  100% {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+
+@keyframes flashIn {
+  0% {
+    opacity: 0;
+    transform: translateY(-8px);
+    background: rgba(56, 139, 253, 0.15);
+  }
+  50% {
+    background: rgba(56, 139, 253, 0.1);
+  }
+  100% {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.5; }
+}
+
+@keyframes statusPulse {
+  0%, 100% {
+    box-shadow: 0 0 0 0 rgba(63, 185, 80, 0.6);
+  }
+  50% {
+    box-shadow: 0 0 0 4px rgba(63, 185, 80, 0);
+  }
+}
+
+@keyframes gaugeGlow {
+  0%, 100% { filter: brightness(1); }
+  50% { filter: brightness(1.3); }
+}
+
+/* Number counting transition */
+@keyframes countUp {
+  from { opacity: 0.5; }
+  to { opacity: 1; }
+}
+
+/* Global smooth transitions */
+.panel * {
+  transition-property: background-color, border-color, color, box-shadow, opacity;
+  transition-duration: 0.3s;
+  transition-timing-function: ease;
+}
+
+/* Mapbox popup dark theme override */
+.mapboxgl-popup-content {
+  background: #111822 !important;
+  border: 1px solid #1a2332 !important;
+  border-radius: 4px !important;
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5), 0 0 1px rgba(88, 166, 255, 0.3) !important;
+  padding: 10px 12px !important;
+}
+
+.mapboxgl-popup-tip {
+  border-top-color: #111822 !important;
+}
+
+.mapboxgl-popup-close-button {
+  color: #5a6a7e !important;
+  font-size: 16px !important;
+}
+
+.mapboxgl-popup-close-button:hover {
+  color: #c8d6e5 !important;
+  background: transparent !important;
+}
