+      VITE_CESIUM_ION_TOKEN: ${CESIUM_ION_TOKEN:-}
+      VITE_API_URL: ${VITE_API_URL:-http://backend:8000}
+    depends_on:
+      - backend
+    volumes:
+      - ./frontend/src:/app/src
+
+volumes:
+  pgdata:
+  telegram_sessions:
